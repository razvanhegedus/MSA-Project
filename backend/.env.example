# Environment
ENVIRONMENT=development
PROJECT_NAME="Pitch Platform API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pitch_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pitch_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/pitch_db

# Security & JWT (15-min access token, 7-day refresh token)
JWT_SECRET_KEY=change-this-secret-key-for-production-use-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Configuration (OpenAI or Gemini OpenAI-compatible)
LLM_API_KEY=your_openai_or_gemini_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
